# Copy to .env (docker compose reads it). Secrets do NOT go here - see ./secrets (make secrets).
ENV=dev
LOCAL_LLM_PROVIDER=ollama        # ollama (real, e.g. Ollama on this machine) | mock (scripted stand-in)
OLLAMA_URL=http://host.docker.internal:11434
LOCAL_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=120
MAX_ITERATIONS=8
EXTERNAL_LLM_PROVIDER=mock       # mock | anthropic
EXTERNAL_MODEL=claude-sonnet-5
EXTERNAL_LLM_ENABLED=true        # false = nothing ever leaves the bank network
APPROVAL_TIMEOUT_SECONDS=900
API_PORT=8080            # host port for the UI/API
